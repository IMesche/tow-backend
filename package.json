{
  "name": "tow-backend",
  "version": "1.0.0",
  "description": "TOW Platform Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init-db": "node scripts/init-db.js",
    "seed": "node scripts/seed-data.js",
    "reset": "rm -f data/tow.db && npm run init-db && npm run seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1"
  }
}
